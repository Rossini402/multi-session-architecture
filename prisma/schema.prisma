generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  cards         KnowledgeCard[] @relation("CreatedCards")
  favorites     Favorite[]
  createdAt     DateTime        @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// 个人技术雷达知识卡片
// sourceType: github | x | article | video | tool | idea | manual
// category:   github-project | ai-coding | frontend | iot | agent-engineering
//             | context-engineering | product-thinking | content-idea | career
//             | tool | thinking
// priority:   P0 | P1 | P2 | P3
model KnowledgeCard {
  id          String     @id @default(cuid())
  title       String
  sourceType  String     @default("manual")
  sourceUrl   String?
  category    String     @default("thinking")
  tags        String?
  score       Int        @default(0)
  priority    String     @default("P2")
  shouldSave  Boolean    @default(true)
  publish     Boolean    @default(false)
  summary     String?
  body        String     @default("")
  rawInput    String?
  createdById String
  createdBy   User       @relation("CreatedCards", fields: [createdById], references: [id])
  favorites   Favorite[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([category])
  @@index([sourceType])
  @@index([priority])
  @@index([publish])
  @@index([createdAt])
}

model Favorite {
  id        String        @id @default(cuid())
  userId    String
  cardId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  card      KnowledgeCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, cardId])
  @@index([userId])
}
