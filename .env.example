# SQLite local file
DATABASE_URL="file:./dev.db"

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Admin gating: only this email can create/edit/delete cards
ADMIN_EMAIL=""

# GitHub OAuth — https://github.com/settings/applications/new
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Anthropic — required for /admin/new AI generation
ANTHROPIC_API_KEY=""
# Optional. Defaults to claude-sonnet-4-6. Use claude-opus-4-7 for higher quality.
ANTHROPIC_MODEL=""
